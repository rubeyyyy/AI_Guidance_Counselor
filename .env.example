APP_NAME="AI Guidance Counselor - Student API"
DATABASE_URL=sqlite:///./student.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Keep the real key only in .env. Use fictional data during development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
GUIDANCE_MAX_OUTPUT_TOKENS=1200
GUIDANCE_HISTORY_TURNS=10
GUIDANCE_QUESTIONNAIRE_ID=initial-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIRECTORY=./chroma_data
RAG_TOP_K=4
RAG_ENABLED=false
# Optional retrieval tuning (character-based chunks, cosine relevance threshold)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_SCORE_THRESHOLD=0.35
# Optional: JSON array of reviewed questionnaire keys allowed in external context.
# GUIDANCE_PROFILE_KEYS=["sample_text","sample_number","sample_choice","sample_choices"]

# Authentication: HTTP cookies are allowed only for local development.
ENVIRONMENT=development
AUTH_DEV_COMMANDS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_HOURS=8
AUTH_RATE_LIMIT=10
AUTH_IP_RATE_LIMIT=300
# Use one hostname consistently for browser and API (localhost OR 127.0.0.1).
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Production: HTTPS origins only, COOKIE_SECURE=true. Prefer a same-site API.

# Email verification and password recovery (backend only).
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Store privately; rotating this key invalidates outstanding email codes.
AUTH_CODE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
# For implicit TLS (usually port 465), use SMTP_SECURITY=tls.
# Plaintext SMTP and console-displayed verification codes are not supported.
