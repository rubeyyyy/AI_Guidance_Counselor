APP_NAME="AI Guidance Counselor - Student API"
DATABASE_URL=sqlite:///./student.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Keep the real key only in .env. Use fictional data during development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
GUIDANCE_MAX_OUTPUT_TOKENS=1200
GUIDANCE_HISTORY_TURNS=10
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIRECTORY=./chroma_data
RAG_TOP_K=4
RAG_ENABLED=false
# Optional retrieval tuning (character-based chunks, cosine relevance threshold)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_SCORE_THRESHOLD=0.35
# Optional: JSON array of reviewed questionnaire keys allowed in external context.
# GUIDANCE_PROFILE_KEYS=["sample_text","sample_number","sample_choice","sample_choices"]
